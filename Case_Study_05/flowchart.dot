digraph G { graph [rankdir=TB, bgcolor="white", nodesep=0.22, ranksep=0.28]; node [fontname="Arial", fontsize=9, style="rounded,filled", fillcolor="#f5f7fb", color="#586b8a"]; edge [color="#586b8a"]; n0 [label="Start", shape=oval]; n1 [label="Read / initialize inputs", shape=box]; n2 [label="Set opening balance.", shape=box]; n3 [label="Display transaction choices.", shape=box]; n4 [label="Read transaction type and amount.", shape=box]; n5 [label="Validate amount.", shape=box]; n6 [label="Update balance for deposit or permitted withdrawal.", shape=box]; n7 [label="Repeat until user chooses exit.", shape=box]; n8 [label="Display transaction summary.", shape=box]; n9 [label="Display result", shape=box]; n10 [label="Stop", shape=oval]; n0->n1; n1->n2; n2->n3; n3->n4; n4->n5; n5->n6; n6->n7; n7->n8; n8->n9; n9->n10; }