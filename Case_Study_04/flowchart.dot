digraph G { graph [rankdir=TB, bgcolor="white", nodesep=0.22, ranksep=0.28]; node [fontname="Arial", fontsize=9, style="rounded,filled", fillcolor="#f5f7fb", color="#586b8a"]; edge [color="#586b8a"]; n0 [label="Start", shape=oval]; n1 [label="Read / initialize inputs", shape=box]; n2 [label="Read attended and total classes.", shape=box]; n3 [label="Validate attendance counts.", shape=box]; n4 [label="Calculate current percentage.", shape=box]; n5 [label="If target is met, display eligible.", shape=box]; n6 [label="Otherwise increment future classes until the target is reached.", shape=box]; n7 [label="Display minimum additional classes.", shape=box]; n8 [label="Display result", shape=box]; n9 [label="Stop", shape=oval]; n0->n1; n1->n2; n2->n3; n3->n4; n4->n5; n5->n6; n6->n7; n7->n8; n8->n9; }