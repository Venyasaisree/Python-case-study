digraph G { graph [rankdir=TB, bgcolor="white", nodesep=0.22, ranksep=0.28]; node [fontname="Arial", fontsize=9, style="rounded,filled", fillcolor="#f5f7fb", color="#586b8a"]; edge [color="#586b8a"]; n0 [label="Start", shape=oval]; n1 [label="Read / initialize inputs", shape=box]; n2 [label="Initialize item names, prices, and stock.", shape=box]; n3 [label="Display menu.", shape=box]; n4 [label="Read item code and quantity.", shape=box]; n5 [label="Validate item and quantity.", shape=box]; n6 [label="Check stock and accept/reject order.", shape=box]; n7 [label="Update stock and sales total.", shape=box]; n8 [label="Continue until exit.", shape=box]; n9 [label="Display sales and remaining stock.", shape=box]; n10 [label="Display result", shape=box]; n11 [label="Stop", shape=oval]; n0->n1; n1->n2; n2->n3; n3->n4; n4->n5; n5->n6; n6->n7; n7->n8; n8->n9; n9->n10; n10->n11; }